# Copy to .env for local runs; on Railway set these as service variables.
# Neon connection string
# Postgres for conversation memory. Leave unset to use a local SQLite file (MEMORY_SQLITE_PATH, default data/memory.sqlite).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
#MEMORY_STORE=sqlite
OPENAI_API_KEY=
# long random string
JWT_SECRET=
# 1 = anyone can use the app without a code (App Store build); 0 = code required
OPEN_ACCESS=1
# per-driver API call caps
RATE_PER_10MIN=300
RATE_PER_DAY=3000
# optional shared code (only needed when OPEN_ACCESS=0)
ACCESS_CODE=
# unlocks the test-scenarios screen (give this one to App Review)
TESTER_CODE=
CORS_ORIGINS=*
HERE_API_KEY=
ORS_API_KEY=
GOOGLE_MAPS_API_KEY=
# put on a Railway volume so satellite verdicts survive deploys
PARKING_CACHE_DIR=/data/parking_cache
# Satellite warm-up of the demo places at startup (1 = on; costs up to ~23 vision calls per cold start)
PARKING_WARM=0
# Requests per minute per driver on authenticated routes (0 = off, for test backends)
RATE_LIMIT_PER_MIN=40
# New devices per IP per 10 min (0 = no limit; raise to ~200 while a build is in App Review)
DEVICES_PER_IP_PER_10MIN=20
# Sign in with Apple / Google: the audiences a provider token must be issued for, comma-separated. Apple = the iOS
# bundle id; Google = the OAuth client ids of every platform. Empty = that sign-in answers 503.
APPLE_AUDIENCES=
GOOGLE_CLIENT_IDS=
# Failed Apple/Google sign-ins per IP per 10 min (0 = no limit); also caps /api/auth/logout calls per IP
SIGNINS_PER_IP_PER_10MIN=30
# The Sign in with Apple key of the developer team (Apple Developer -> Keys, the .p8 file): team id, key id and the
# PEM text on one line with \n for the line breaks. With them (and CREDENTIALS_KEY) the backend keeps Apple's refresh
# token per account, encrypted, and revokes it when the account is deleted, which Apple requires. Without them
# sign-in works, nothing is kept, and a deleted account is not revoked at Apple.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Days a signed-in phone may stay unused before it is signed out (0 = never)
ACCOUNT_SESSION_IDLE_DAYS=180
# Days an expired driver token keeps working while its device row exists (0 = off). App build 2 never refreshes.
TOKEN_GRACE_DAYS=365
# Kill switch for a leak: expired tokens issued before this ISO date/time get no grace
TOKEN_GRACE_NOT_BEFORE=
# Swagger UI at /api/docs (dev only)
DEV_DOCS=0

# ---- 1.1 features (all on by default unless noted; flip to 0 on Railway to turn one off without a deploy) ----
# HERE: posted speed limits, traffic incidents/closures, 2 alternative routes with labels and tolls, route handle
# for re-routing after a deviation (POST /api/reroute)
ROUTE_SPEED_LIMITS=1
ROUTE_INCIDENTS=1
ROUTE_ALTERNATIVES=1
REROUTE_ENABLED=1
# Google Places reviews on places (same SKU as editorialSummary)
PLACE_REVIEWS=1
# Spoken LLM gist of those reviews (off: Google's terms limit derived content and caching; the voice reads the rating)
REVIEW_GIST=0
# EIA weekly regional diesel average for "that's 30 cents above the California average" (free key: eia.gov/opendata)
EIA_ENABLED=1
EIA_API_KEY=
# Extra place categories: walmart,cat_scale,truck_wash,weigh_station or "all". OFF until the app draws their pins.
CATEGORIES_EXTRA=
# NWS weather alerts along new routes and the "weather in Reno at 3pm" intent; NWS asks for a contact User-Agent
WEATHER_ALERTS=1
NWS_USER_AGENT=(TruckBuddy, support@truckbuddy.io)
# Caltrans chain controls (districts polled every 10 min) on California routes
CHAIN_CONTROLS=1
CHAIN_DISTRICTS=2,3,6,9,10
# Live truck parking counts from the open TPIMS feeds (WI, KY, IL); add states as JSON {"KS": [dynamic_url, static_url]}
TPIMS_ENABLED=1
TPIMS_FEEDS=
# Hours of service: a solo driver's own Motive key (sent per request as X-Motive-Key, never stored), or a fleet's key
# stored encrypted with CREDENTIALS_KEY and used only for drivers the fleet mapped to a Motive user
HOS_MOTIVE=1
# Driver transcripts and spoken text in the log stream (1 on dev and the test stand; off in production)
LOG_TRANSCRIPTS=0
# /api/health?deep=1 makes one HERE geocode call (at most every 30 s); 0 skips it
HEALTH_HERE=1
# OpenAI TTS model (gpt-4o-mini-tts; tts-1 to switch back)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
