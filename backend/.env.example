# Copy to .env for local runs; on Railway set these as service variables.
# Neon connection string
# Postgres for conversation memory. Leave unset to use a local SQLite file (MEMORY_SQLITE_PATH, default data/memory.sqlite).
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
#MEMORY_STORE=sqlite
OPENAI_API_KEY=
# long random string
JWT_SECRET=
# 1 = anyone can use the app without a code (App Store build); 0 = code required
OPEN_ACCESS=1
# per-driver API call caps
RATE_PER_10MIN=300
RATE_PER_DAY=3000
# optional shared code (only needed when OPEN_ACCESS=0)
ACCESS_CODE=
# unlocks the test-scenarios screen (give this one to App Review)
TESTER_CODE=
CORS_ORIGINS=*
HERE_API_KEY=
ORS_API_KEY=
GOOGLE_MAPS_API_KEY=
# put on a Railway volume so satellite verdicts survive deploys
PARKING_CACHE_DIR=/data/parking_cache
# Satellite warm-up of the demo places at startup (1 = on; costs up to ~23 vision calls per cold start)
PARKING_WARM=0
# Requests per minute per driver on authenticated routes (0 = off, for test backends)
RATE_LIMIT_PER_MIN=40
# Swagger UI at /api/docs (dev only)
DEV_DOCS=0

# ---- 1.1 features (all on by default unless noted; flip to 0 on Railway to turn one off without a deploy) ----
# HERE: posted speed limits, traffic incidents/closures, 2 alternative routes with labels and tolls, route handle
# for re-routing after a deviation (POST /api/reroute)
ROUTE_SPEED_LIMITS=1
ROUTE_INCIDENTS=1
ROUTE_ALTERNATIVES=1
REROUTE_ENABLED=1
# Google Places reviews on places (same SKU as editorialSummary)
PLACE_REVIEWS=1
# Spoken LLM gist of those reviews (off: Google's terms limit derived content and caching; the voice reads the rating)
REVIEW_GIST=0
# EIA weekly regional diesel average for "that's 30 cents above the California average" (free key: eia.gov/opendata)
EIA_ENABLED=1
EIA_API_KEY=
# Extra place categories: walmart,cat_scale,truck_wash,weigh_station or "all". OFF until the app draws their pins.
CATEGORIES_EXTRA=
# NWS weather alerts along new routes and the "weather in Reno at 3pm" intent; NWS asks for a contact User-Agent
WEATHER_ALERTS=1
NWS_USER_AGENT=(TruckBuddy, support@truckbuddy.io)
# Caltrans chain controls (districts polled every 10 min) on California routes
CHAIN_CONTROLS=1
CHAIN_DISTRICTS=2,3,6,9,10
# Live truck parking counts from the open TPIMS feeds (WI, KY, IL); add states as JSON {"KS": [dynamic_url, static_url]}
TPIMS_ENABLED=1
TPIMS_FEEDS=
# Hours of service from the driver's own Motive key (sent per request as X-Motive-Key, never stored)
HOS_MOTIVE=1
# OpenAI TTS model (gpt-4o-mini-tts; tts-1 to switch back)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
